# Database
DATABASE_URL=postgresql://forge3d:forge3d_dev@localhost:5432/forge3d

# Redis
REDIS_URL=redis://localhost:6379

# Auth
BETTER_AUTH_SECRET=your-secret-key-change-in-production
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
NODE_ENV=development

# Storage
UPLOAD_DIR=./uploads
STORAGE_BASE_URL=http://localhost:4000/uploads

# Search
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=forge3d_search_dev

# Client dev mode — set to "true" to use mock data without backend
VITE_USE_MOCKS=false

# YippieBlox MCP server (Roblox Studio bridge, declared in .mcp.json)
# Claude Code expands these from the shell environment, not from .env, so
# export them before running `claude`. Requires the
# roblox-studio-yippieblox-mcp-server binary on PATH (GitHub Releases of
# yippieeeeeeeeiokayay/yippieblox-mcp-server) and Roblox Studio installed.
YIPPIE_TOKEN=your-yippieblox-bearer-token
YIPPIE_PORT=3334
