# Database
DATABASE_URL=postgresql://forge3d:forge3d_dev@localhost:5432/forge3d

# Redis
REDIS_URL=redis://localhost:6379

# Auth
BETTER_AUTH_SECRET=your-secret-key-change-in-production
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
NODE_ENV=development

# Storage
UPLOAD_DIR=./uploads
STORAGE_BASE_URL=http://localhost:4000/uploads

# AI generation: self-hosted workers (see workers/README.md). Modal: the URL `modal deploy
# workers/modal_app.py` prints (https://<workspace>--orainge-ai-api.modal.run) and the
# ORAINGE_WORKER_TOKEN you stored in Modal. Or RunPod: the API key and endpoint ids.
AI_WORKERS_URL=
AI_WORKERS_TOKEN=
# Development only: 1 = stand-in workers (no GPU, no cost) for trying the Studio's AI panel
AI_WORKERS_MOCK=
# 1 = draw the chosen picture from 6 sides (the multiview worker) before the 3D preview, and build
# the preview and final from those views too, so the model's back isn't invented. Off by default.
# Needs the multiview worker (on Modal, in the job API; on RunPod, RUNPOD_MULTIVIEW_ENDPOINT_ID)
# and the ai_generations columns views and views_error (`drizzle-kit push`). If the views fail or
# take over 3 minutes, the model is made from the picture alone.
AI_MULTIVIEW=
RUNPOD_API_KEY=
RUNPOD_TRELLIS2_ENDPOINT_ID=
RUNPOD_REFERENCE_ENDPOINT_ID=
RUNPOD_MULTIVIEW_ENDPOINT_ID=

# Search
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=forge3d_search_dev

# Client dev mode — set to "true" to use mock data without backend
VITE_USE_MOCKS=false
